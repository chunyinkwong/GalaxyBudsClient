<Project Sdk="Microsoft.NET.Sdk">
    <!--
      iOS head project for the Avalonia application.

      Produces GalaxyBudsClient.app for iOS devices (arm64). The CI workflow
      (.github/workflows/compile-ios.yml) packages the app bundle into an unsigned .ipa
      that can be re-signed and sideloaded with AltStore / Sideloadly / Xcode.

      Local build (requires macOS + Xcode):
        dotnet workload install ios
        dotnet build -f net10.0-ios -c Release -r ios-arm64
    -->
    <Import Project="../GalaxyBudsClient/Application.props" />

    <PropertyGroup>
        <TargetFramework>net10.0-ios</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">ios-arm64</RuntimeIdentifier>
        <!-- Must differ from the referenced project's assembly name (GalaxyBudsClient) -->
        <AssemblyName>GalaxyBudsClient.iOS</AssemblyName>
        <RootNamespace>GalaxyBudsClient.iOS</RootNamespace>
        <ApplicationTitle>Galaxy Buds Manager</ApplicationTitle>
        <ApplicationId>me.timschneeberger.galaxybudsclient</ApplicationId>
        <XSAppIconAssets>Assets.xcassets/AppIcon.appiconset</XSAppIconAssets>
        <EnableDefaultItems>true</EnableDefaultItems>

        <!--
          The referenced GalaxyBudsClient project is a library for iOS (IsIOS=true switches its
          OutputType), but the executable-reference validation can run against an evaluation that
          doesn't see the IsIOS property (it then looks like a desktop "Exe" because the CI runner
          is macOS). CI passes -p:IsIOS=true to the whole graph; disabling the validation keeps the
          build working even if the property is lost somewhere (this is an app, nothing executes
          the reference).
        -->
        <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>

        <!--
          Builds are unsigned by default so that CI can produce an installable artifact without
          requiring access to an Apple developer account. Re-signing is done at install time.
          Pass -p:EnableCodeSigning=true (plus CodesignKey/CodesignProvision) for a signed build.
        -->
        <EnableCodeSigning Condition="'$(EnableCodeSigning)' == ''">false</EnableCodeSigning>
        <CodesignRequireProvisioningProfile Condition="'$(EnableCodeSigning)' != 'true'">false</CodesignRequireProvisioningProfile>
        <CodesignKey Condition="'$(EnableCodeSigning)' != 'true'"></CodesignKey>
        <CodesignProvision Condition="'$(EnableCodeSigning)' != 'true'"></CodesignProvision>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.iOS" Version="$(AvaloniaVersion)" />
        <!-- Provides the native SkiaSharp binaries for iOS (arm64) -->
        <PackageReference Include="SkiaSharp.NativeAssets.iOS" Version="3.119.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../GalaxyBudsClient/GalaxyBudsClient.csproj">
            <AdditionalProperties>IsIOS=true</AdditionalProperties>
        </ProjectReference>
    </ItemGroup>

    <!--
      Keep the FluentIcons glyph font in the bundle.

      FluentAvalonia's control templates (NavigationView pane items, InfoBar, ComboBox chevrons, ...)
      draw every glyph with the "Seagull Fluent Icons" font. That font lives as an embedded asset
      inside FluentIcons.Resources.Avalonia.dll (~7.6 MB of .otf files under Assets/) and is reached
      only through avares://FluentIcons.Resources.Avalonia/Assets URIs - i.e. through strings. Nothing
      in IL references that assembly, so the ILLink pass that iOS always runs (PublishTrimmed with
      TrimMode=full is the default for net*-ios) drops the whole assembly from the app bundle.

      Symptom of the assembly being missing: the first FontIcon.MeasureOverride throws
      "Could not create glyphTypeface. Font family: Seagull Fluent Icons (key:
      avares://FluentIcons.Resources.Avalonia/Assets)" (System.InvalidOperationException), which
      escapes the layout pass into native code and aborts the process with SIGABRT ~0.3s after launch
      - no dialog, no managed log entry, only a Sentry/official crash report.

      Rooting the resource assembly keeps it (and therefore its embedded fonts) intact.
    -->
    <ItemGroup>
        <TrimmerRootAssembly Include="FluentIcons.Resources.Avalonia" />
    </ItemGroup>
</Project>
